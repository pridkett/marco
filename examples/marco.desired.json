{
  "version": 1,
  "default": {"mode": "filtered", "pool": "resolver"},
  "pools": {
    "resolver": [
      {
        "transport": "dot",
        "address": "192.0.2.53",
        "serverName": "replace-with-profile.example"
      }
    ]
  },
  "groups": {
    "infrastructure": {},
    "mobile": {},
    "iot": {},
    "trusted": {},
    "other": {}
  },
  "subscriptions": {
    "adguard-filters-1": {
      "name": "AdGuard DNS filter",
      "format": "adguard",
      "url": "https://adguardteam.github.io/HostlistsRegistry/assets/filter_1.txt",
      "enabled": true
    },
    "adguard-filters-2": {
      "name": "AdAway Default Blocklist",
      "format": "adguard",
      "url": "https://adguardteam.github.io/HostlistsRegistry/assets/filter_2.txt",
      "enabled": false
    },
    "demo-local": {"file": "demo.txt", "enabled": true}
  },
  "zones": [
    {"name": "home.arpa.", "private": true, "publish": true}
  ],
  "reverse": ["192.168.0.0/16", "fd00::/8"],
  "dynamicTTL": 60,
  "staticTTL": 300,
  "records": [
    {"name": "welcome.home.arpa.", "type": "A", "value": "192.0.2.10"}
  ]
}
